font-family = JetBrainsMono Nerd Font
font-size = 12
theme = dark:Catppuccin Mocha,light:Catppuccin Latte
window-padding-x = 8
window-padding-y = 6
copy-on-select = clipboard
shell-integration = zsh

# notificação quando um comando longo termina e a janela não está em foco (substitui o zsh-background-notify)
notify-on-command-finish = unfocused
notify-on-command-finish-action = notify
notify-on-command-finish-after = 10s

# splits (no lugar do tmux): Alt+hjkl navega, como era no tmux
keybind = alt+h=goto_split:left
keybind = alt+j=goto_split:down
keybind = alt+k=goto_split:up
keybind = alt+l=goto_split:right
keybind = alt+z=toggle_split_zoom
keybind = alt+equal=equalize_splits
