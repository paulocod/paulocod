[user]
	name = Paulo Campos
	email = paulo4-0@outlook.com
	signingkey = 4CDB1E2055D2103A88C4AED2959E3D5A9F976B6E
[core]
	editor = nvim
[init]
	defaultBranch = main
[color "branch"]
	current = white
	remote = red
[alias]
	s = status -sb
  up = pull --rebase --autostash
	wip = commit -am "wip" --no-verify
	tree = log --graph --pretty=format:'%C(yellow)%h%Creset -%C(auto)%d%Creset %s %C(blue)(%cr) %C(dim white)<%an>' --all
	fixup = commit --fixup
	autosquash = rebase -i --autosquash
	clean-merged = "!git branch --merged | egrep -v '(^\\*|^(main|master|develop|dev)$)' | xargs -r -n 1 git branch -d"
	l = log --pretty=format:'%C(blue)%h%C(red)%d %C(white)%s - %C(cyan)%cn, %C(green)%cr'
	save = stash push -u -m
	pop = stash pop
	sw = switch
	sm = switch main
	cb = checkout -b
	last = show --name-only HEAD
	remotes = remote -v
	branches = branch -l
	incoming = !(git fetch --quiet && git log --pretty=format:'%C(yellow)%h %C(white)- %C(red)%an %C(white)- %C(cyan)%d%Creset %s %C(white)- %ar%Creset' ..@{u})
	outgoing = !(git fetch --quiet && git log --pretty=format:'%C(yellow)%h %C(white)- %C(red)%an %C(white)- %C(cyan)%d%Creset %s %C(white)- %ar%Creset' @{u}..)
	unstage = reset HEAD --
	undo = checkout --
	tags = tag -l --sort=-v:refname
	amend = commit --amend --no-edit
	rollback = reset --soft HEAD~1
	pr = "!gh pr view --web"
	prs = "!gh pr list"
	merge = "!gh pr merge --squash"
[commit]
	gpgsign = true

[includeIf "gitdir:/home/paulo/Projects/rentbrella/"]
    path = ~/.gitconfig-rentbrella
