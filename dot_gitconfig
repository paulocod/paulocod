[user]
	name = Paulo Campos
	# sem e-mail global: fora das pastas abaixo o git recusa commitar em vez de chutar
	useConfigOnly = true
[core]
	editor = nvim
	hooksPath = /home/paulo-campos/.config/git/hooks
[init]
	defaultBranch = main
[color "branch"]
	current = white
	remote = red
[alias]
	s = status -sb
	up = pull --rebase --autostash
	wip = commit -am "wip" --no-verify
	tree = log --graph --pretty=format:'%C(yellow)%h%Creset -%C(auto)%d%Creset %s %C(blue)(%cr) %C(dim white)<%an>' --all
	fixup = commit --fixup
	autosquash = rebase -i --autosquash
	clean-merged = "!git branch --merged | egrep -v '(^\\*|^(main|master|develop|dev)$)' | xargs -r -n 1 git branch -d"
	l = log --pretty=format:'%C(blue)%h%C(red)%d %C(white)%s - %C(cyan)%cn, %C(green)%cr'
	save = stash push -u -m
	pop = stash pop
	sw = switch
	sm = switch main
	cb = checkout -b
	last = show --name-only HEAD
	remotes = remote -v
	branches = branch -l
	incoming = !(git fetch --quiet && git log --pretty=format:'%C(yellow)%h %C(white)- %C(red)%an %C(white)- %C(cyan)%d%Creset %s %C(white)- %ar%Creset' ..@{u})
	outgoing = !(git fetch --quiet && git log --pretty=format:'%C(yellow)%h %C(white)- %C(red)%an %C(white)- %C(cyan)%d%Creset %s %C(white)- %ar%Creset' @{u}..)
	unstage = reset HEAD --
	undo = checkout --
	tags = tag -l --sort=-v:refname
	amend = commit --amend --no-edit
	rollback = reset --soft HEAD~1
	pr = "!gh pr view --web"
	prs = "!gh pr list"
	pm = "!gh pr merge --squash"
[commit]
	gpgsign = true

[push]
	autoSetupRemote = true
[fetch]
	prune = true
[merge]
	conflictStyle = zdiff3
[rerere]
	enabled = true
[tag]
	gpgSign = true

# identidades por pasta
[includeIf "gitdir:~/Projects/alexandria/"]
	path = ~/.gitconfig-pessoal
[includeIf "gitdir:~/Projects/rentbrella/"]
	path = ~/.gitconfig-rentbrella
[includeIf "hasconfig:remote.*.url:git@github.com:*/**"]
	path = ~/.gitconfig-pessoal
[includeIf "hasconfig:remote.*.url:https://github.com/**"]
	path = ~/.gitconfig-pessoal
